#!/usr/bin/env python3
r"""커밋 메시지 형식을 강제한다 — 팀 전역 커밋 템플릿 규약.

제목: `<타입> : <제목>` (타입: feat · fix · docs · test · refact · style · chore)
꼬릿말: 기능 변경(feat·fix)은 테스트 목록 ID를 단다 — `Tests: T3,T4`.
어느 항목을 통과시킨 커밋인지가 `git log --grep "^Tests: T"`로 진행 상황의 정본이 된다.
동작 불변 정리(refact·style)는 테스트 디렉터리를 바꿀 수 없다 (Tidy First).
"""
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from _harness import record, tests_dir  # noqa: E402

TYPES = ("feat", "fix", "docs", "test", "refact", "style", "chore")
TITLE = re.compile(rf"^({'|'.join(TYPES)}) ?: \S.*")
TESTS_FOOTER = re.compile(r"^Tests: T\d+(,\s*T\d+)*\s*$")
SKIP = re.compile(r"^(Merge |Revert |fixup!|squash!)")
# 템플릿 주석 문자가 사람마다 다를 수 있다(core.commentChar). 정리되지 않은 주석 줄은 건너뛴다.
COMMENT = re.compile(r"^\s*[#;]")

HELP = """커밋 메시지 형식 (팀 전역 커밋 템플릿):
  <타입> : <제목>      타입 = feat | fix | docs | test | refact | style | chore
  (빈 줄)
  본문 (선택)
  (빈 줄)
  Tests: T<n>[,T<m>]   feat·fix는 필수 — 통과시킨 테스트 목록 ID
refact·style은 테스트 디렉터리를 바꿀 수 없다. 사람이 의도적으로 우회할 때만 --no-verify"""


def block(reason: str, extra: str = HELP) -> None:
    record("commit-msg", reason)
    print(f"커밋 차단 — {reason}\n\n{extra}", file=sys.stderr)
    sys.exit(1)


lines = [ln.rstrip() for ln in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
         if not COMMENT.match(ln)]
lines = [ln for ln in lines if ln.strip()] or [""]
first = lines[0].strip()

if SKIP.match(first):
    sys.exit(0)

m = TITLE.match(first)
if not m:
    block(f"제목 형식 위반: {first[:60]!r}")
kind = m.group(1)

if kind in ("feat", "fix") and not any(TESTS_FOOTER.match(ln.strip()) for ln in lines[1:]):
    block(f"{kind} 커밋에 'Tests: T<n>' 꼬릿말이 없다")

# pre-commit에서는 메시지를 볼 수 없다. 동작 불변 커밋의 테스트 변경 금지를 여기서 검사한다.
if kind in ("refact", "style"):
    staged = subprocess.run(["git", "diff", "--cached", "--name-only"],
                            capture_output=True, text=True).stdout.split()
    tdir = tests_dir()
    tests = [f for f in staged if f.startswith(tdir)]
    if tests:
        block(f"{kind} 커밋이 {tdir}를 변경한다: {', '.join(tests[:5])}",
              "테스트가 바뀌면 그것은 동작 변경이다. feat 또는 fix로, 'Tests: T<n>' 꼬릿말을 달아 커밋한다.")

sys.exit(0)
